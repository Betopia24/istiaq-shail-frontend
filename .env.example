# Server-only settings (never NEXT_PUBLIC_: the browser must not see them).

# Backend base URL, without /v1. The browser never calls it directly: every call goes through /api/backend.
API_URL=http://localhost:5050

# Signs the pp_session cookie used for route protection. At least 32 characters: openssl rand -base64 48
# Changing it signs everyone out of the frontend.
SESSION_SECRET=

# Production: run Next behind a reverse proxy (nginx, Caddy, the platform's edge) that sets X-Forwarded-For.
# The real client IP is forwarded to the API for its per-IP rate limits.

# Stripe publishable key (pk_test_... / pk_live_...): public by design, used by the "Buy extra packs" card form.
# The checkout page gets its key from the API, so only the top-up modal needs this.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key for the buyer's "Book a viewing" form. Leave empty in development.
# (The backend needs the matching secret: CAPTCHA_PROVIDER=turnstile, TURNSTILE_SECRET_KEY.)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
